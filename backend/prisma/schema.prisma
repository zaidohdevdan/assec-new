generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  name       String
  role       Role       @default(USER)
  cpf        String?    @unique
  rg         String?
  matricula  String?    @unique
  status     String     @default("Ativo")
  org        String?
  since      DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  schedules  Schedule[]
  photoUrl   String?
  avatarUrl  String?

  // Professional fields
  specialty  String?
  slots      ScheduleSlot[] @relation("ProfessionalSlots")
  notifications Notification[]
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ScheduleSlot {
  id             String     @id @default(uuid())
  professionalId String
  professional   User       @relation("ProfessionalSlots", fields: [professionalId], references: [id])
  date           String     // e.g. "2026-06-15"
  time           String     // e.g. "09:00"
  status         String     @default("Disponível") // "Disponível", "Reservado", "Cancelado"
  schedule       Schedule?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  slotId    String?  @unique
  slot      ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  type      String
  title     String
  date      String
  time      String
  info      String?
  status    String   @default("Agendado")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Benefit {
  id          String   @id @default(uuid())
  title       String
  tag         String   // Category/Type of benefit: "Jurídico", "Saúde", "Educação", "Lazer", "Assistência"
  description String   // Short description
  details     String?  // Detailed description (supports markdown/long text)
  image       String?  // Base64 or image URL (optional)
  icon        String?  // Lucide icon name, e.g. "Shield", "Heart", "Key", "ShieldCheck", "Landmark"
  
  // Specific for Inns/Pousadas (optional fields)
  location    String?  // Location, e.g. "Beberibe - Praia das Fontes"
  amenities   String[] // Array of amenities, e.g. ["Wi-Fi", "Piscina"]
  
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  summary     String?
  content     String
  type        String   @default("Institucional")
  tags        String[]
  coverImage  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  PROFESSIONAL
  PRESIDENT
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FinancialRecord {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // "INCOME" (Receita) ou "EXPENSE" (Despesa)
  category    String   // Ex: "Mensalidades", "Lazer", "Jurídico", "Administrativo", "Eventos"
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

